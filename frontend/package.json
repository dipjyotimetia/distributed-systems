{
  "name": "frontend",
  "version": "1.4.139",
  "private": true,
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --coverage --watchAll=false",
    "test:e2e": "playwright test",
    "test:e2e:ci": "echo 'E2E tests skipped in CI - run separately with test:e2e if server is available'",
    "test:e2e:headless": "npx playwright install --with-deps chromium && playwright test --config=playwright.config.headless.ts",
    "debug:ci": "node debug-ci.js",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:with-backend": "../scripts/run-e2e-tests.sh",
    "test:e2e:real-backend": "playwright test --config=playwright.config.real-backend.ts",
    "proto:generate": "cd .. && bash scripts/frontend-proto.sh"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@connectrpc/connect": "2.3.0",
    "@connectrpc/connect-node": "2.3.0",
    "@hookform/resolvers": "^7.0.8",
    "@opentelemetry/api": "~1.9.0",
    "@opentelemetry/context-zone": "^2.12.0",
    "@opentelemetry/core": "^2.12.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.2",
    "@opentelemetry/instrumentation": "^0.223.2",
    "@opentelemetry/instrumentation-fetch": "^0.223.2",
    "@opentelemetry/resources": "2.12.1",
    "@opentelemetry/sdk-trace-base": "2.12.1",
    "@opentelemetry/sdk-trace-node": "2.12.1",
    "@opentelemetry/sdk-trace-web": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@types/js-cookie": "^3.0.6",
    "axios": "1.21.1",
    "js-cookie": "^3.0.8",
    "lucide-react": "^1.78.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.17.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
