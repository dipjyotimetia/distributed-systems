# Banking Application .gitignore

# Environment files
.env
.env.local
.env.*.local

# Logs
logs/
*.log
/var/log/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Java/Maven
target/
!**/src/main/**/target/
!**/src/test/**/target/

# .NET
bin/
obj/
publish/
*.user
*.suo

# Node.js/NPM
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
out/
build/
dist/

# Database
*.db
*.sqlite
*.sqlite3

# Docker
.dockerignore
!frontend/.dockerignore

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Test coverage
coverage/
*.cover
*.py,cover
.coverage
.coverage.*
.cache
.pytest_cache/

# Test results and reports
playwright-report/
test-results/

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*.swo

# Build artifacts
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Spring Boot
*.pid
spring-shell.log

# Application specific
application-local.yml
application-local.properties

# Offline WireMock replay run outputs (committed fixtures live under tests/replay/).
backend/*/replay-results/
**/*.log

# Claude Code
.claude/
thoughts/

# Local Temporal integration reports
/tests/integration/temporal/results/

# Local development certificates
/certs/dev/

.gradle/
**/build/
!gradle/wrapper/gradle-wrapper.jar

# Archify authoring scratch (curated diagrams live under docs/architecture/)
.archify/
**/.archify-delivery-lock.json
**/*.delivery-pending.json
