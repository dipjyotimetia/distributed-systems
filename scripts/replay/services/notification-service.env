SERVICE_DIR_REL="backend/notification-service"
RUNTIME=go
BUILD_CMD='go build -o bin/notification-service ./cmd/server'
ARTIFACT_GLOB='bin/notification-service'
APP_PORT=8080
HEALTH_PATHS=("/api/v1/health")
NEEDS_POSTGRES=0
NEEDS_MONGO=1
NEEDS_KAFKA=1
JWT_RESIGN=0
MINT_JWT=1
SCHEMA_VALIDATE=1
PROPERTY_VALIDATE=0

APP_ENV=(
  "HTTP_PORT=${APP_PORT}"
  "JWT_SECRET=${REPLAY_JWT_SECRET}"
  "MONGO_URI=mongodb://127.0.0.1:${MONGO_PORT}"
  "KAFKA_BROKERS=127.0.0.1:${KAFKA_PORT}"
  "SCHEMA_REGISTRY_URL=http://127.0.0.1:${SCHEMA_REGISTRY_PORT}"
  "SLACK_WEBHOOK_URL=http://127.0.0.1:${WIREMOCK_PORT}/slack"
  "SENDGRID_API_URL=http://127.0.0.1:${WIREMOCK_PORT}/v3/mail/send"
  "TWILIO_API_BASE_URL=http://127.0.0.1:${WIREMOCK_PORT}"
  "OTEL_SDK_DISABLED=true"
)
