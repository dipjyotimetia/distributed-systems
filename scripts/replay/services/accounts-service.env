SERVICE_DIR_REL="backend/accounts-service"
RUNTIME=java
BUILD_CMD='../../gradlew -p ../.. -q :accounts-service:clean :accounts-service:bootJar'
ARTIFACT_GLOB='build/libs/application.jar'
APP_PORT=8080
HEALTH_PATHS=("/actuator/health/liveness" "/actuator/health")
NEEDS_POSTGRES=1
POSTGRES_SCHEMAS=("accounts_service")
NEEDS_MONGO=0
NEEDS_KAFKA=0
JWT_RESIGN=0
MINT_JWT=1
SCHEMA_VALIDATE=1
PROPERTY_VALIDATE=1

APP_ENV=(
  "JWT_SECRET=${REPLAY_JWT_SECRET}"
  "DB_HOST=${PGHOST}"
  "DB_PORT=${PGPORT}"
  "DB_NAME=${PGDATABASE}"
  "SPRING_DATASOURCE_USERNAME=${PGUSER}"
  "SPRING_DATASOURCE_PASSWORD=${PGPASSWORD}"
  "SPRING_FLYWAY_USER=${PGUSER}"
  "SPRING_FLYWAY_PASSWORD=${PGPASSWORD}"
  "PLAID_BASE_URL=http://127.0.0.1:${WIREMOCK_PORT}/plaid"
  "EXCHANGE_RATES_URL=http://127.0.0.1:${WIREMOCK_PORT}/exchange"
  "MOODYS_API_URL=http://127.0.0.1:${WIREMOCK_PORT}/ratings"
  "LEDGER_GRPC_ENABLED=false"
)

APP_FLAGS=(
  "-Dotel.sdk.disabled=true"
  "-Dotel.traces.exporter=none"
  "-Dotel.metrics.exporter=none"
  "-Dotel.logs.exporter=none"
  "-Dmanagement.health.db.enabled=true"
)
