SERVICE_DIR_REL="backend/ai-service"
RUNTIME=python
BUILD_CMD='python3 -m pip install -q -r requirements.txt'
ARTIFACT_GLOB=''
APP_PORT=8080
HEALTH_PATHS=("/api/v1/health")
NEEDS_POSTGRES=0
NEEDS_MONGO=0
NEEDS_KAFKA=0
JWT_RESIGN=0
SCHEMA_VALIDATE=1
PROPERTY_VALIDATE=1
# FastAPI app object is `app` in main.py
PYTHON_MODULE='main:app'

APP_ENV=(
  "AI_PROVIDER_MODE=live"
  "ANTHROPIC_URL=http://127.0.0.1:${WIREMOCK_PORT}/ai/anthropic"
  "OPENAI_URL=http://127.0.0.1:${WIREMOCK_PORT}/ai/openai"
  "GEMINI_URL=http://127.0.0.1:${WIREMOCK_PORT}/ai/gemini"
  "XAI_URL=http://127.0.0.1:${WIREMOCK_PORT}/ai/xai"
  "OPENROUTER_URL=http://127.0.0.1:${WIREMOCK_PORT}/ai/openrouter"
  "AI_API_KEY=synthetic-key"
  "OPENAI_API_KEY=synthetic-key"
  "GEMINI_API_KEY=synthetic-key"
  "XAI_API_KEY=synthetic-key"
  "OPENROUTER_API_KEY=synthetic-key"
  "OTEL_SDK_DISABLED=true"
)
