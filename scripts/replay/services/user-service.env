SERVICE_DIR_REL="backend/user-service"
RUNTIME=dotnet
BUILD_CMD='dotnet publish -c Release -o publish'
ARTIFACT_GLOB='publish/user-service-dotnet.dll'
APP_PORT=8080
HEALTH_PATHS=("/actuator/health")
NEEDS_POSTGRES=1
POSTGRES_SCHEMAS=("user_service")
NEEDS_MONGO=0
NEEDS_KAFKA=0
JWT_RESIGN=0
SCHEMA_VALIDATE=0
PROPERTY_VALIDATE=0

APP_ENV=(
  "ASPNETCORE_URLS=http://127.0.0.1:${APP_PORT}"
  "DB_HOST=${PGHOST}"
  "DB_PORT=${PGPORT}"
  "DB_NAME=${PGDATABASE}"
  "DB_USERNAME=${PGUSER}"
  "DB_PASSWORD=${PGPASSWORD}"
  "DB_SCHEMA=user_service"
  "JWT_SECRET=${REPLAY_JWT_SECRET}"
  "SOCURE_BASE_URL=http://127.0.0.1:${WIREMOCK_PORT}/socure"
  "JUMIO_BASE_URL=http://127.0.0.1:${WIREMOCK_PORT}/jumio"
  "HIBP_BASE_URL=http://127.0.0.1:${WIREMOCK_PORT}/hibp"
  "OTEL_SDK_DISABLED=true"
)
