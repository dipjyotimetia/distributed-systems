SERVICE_DIR_REL="backend/transactions-service"
RUNTIME=java
BUILD_CMD='../../gradlew -p ../.. -q :transactions-service:clean :transactions-service:bootJar'
ARTIFACT_GLOB='build/libs/application.jar'
APP_PORT=8080
HEALTH_PATHS=("/actuator/health/liveness" "/actuator/health")
NEEDS_POSTGRES=1
POSTGRES_SCHEMAS=("transactions_service")
NEEDS_MONGO=0
NEEDS_KAFKA=0
JWT_RESIGN=0
MINT_JWT=1
SCHEMA_VALIDATE=1
PROPERTY_VALIDATE=0

APP_ENV=(
  "JWT_SECRET=${REPLAY_JWT_SECRET}"
  "DB_HOST=${PGHOST}"
  "DB_PORT=${PGPORT}"
  "DB_NAME=${PGDATABASE}"
  "SPRING_DATASOURCE_USERNAME=${PGUSER}"
  "SPRING_DATASOURCE_PASSWORD=${PGPASSWORD}"
  "SPRING_FLYWAY_USER=${PGUSER}"
  "SPRING_FLYWAY_PASSWORD=${PGPASSWORD}"
  "FRAUD_FAIL_OPEN=true"
  "TRANSACTIONS_OUTBOX_PUBLISH_ENABLED=false"
  "ERROR_SPIKE_ENABLED=false"
  "PAYMENT_STRIPE_URL=http://127.0.0.1:${WIREMOCK_PORT}/v1/payment_intents"
  "PAYMENT_PAYPAL_URL=http://127.0.0.1:${WIREMOCK_PORT}/v2/checkout/orders"
  "PAYMENT_COMPLY_BASE_URL=http://127.0.0.1:${WIREMOCK_PORT}"
  "KAFKA_BROKERS=127.0.0.1:1"
)

APP_FLAGS=(
  "-Dotel.sdk.disabled=true"
  "-Dotel.traces.exporter=none"
  "-Dotel.metrics.exporter=none"
  "-Dotel.logs.exporter=none"
  "-Dmanagement.health.kafka.enabled=false"
)
