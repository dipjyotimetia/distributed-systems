    "@opentelemetry/semantic-conventions": "^1.45.0",
    "axios": "1.21.1",
    "dotenv": "^18.0.10",
    "uuid": "^14.0.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "jest": "^30.5.2",
