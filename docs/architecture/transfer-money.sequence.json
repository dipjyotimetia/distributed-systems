  "cards": [
    {
      "dot": "emerald",
      "title": "Happy path",
      "items": [
        "Frontend never calls transactions directly; API_GATEWAY_URL is the edge",
        "Fraud screening runs before ledger post; fail-open is configurable",
        "Outbox publish is async relative to the HTTP response path"
      ]
    },
    {
      "dot": "rose",
      "title": "Guards",
      "items": [
        "JWT is validated at the gateway for protected banking routes",
        "Idempotency-Key lets clients safely retry transfers",
        "Ledger writes go through accounts gRPC, not a shared SQL table"
      ]
    }
