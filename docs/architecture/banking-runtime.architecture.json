  "cards": [
    {
      "dot": "cyan",
      "title": "Primary journey",
      "items": [
        "Browser traffic enters Next.js, which proxies JWT banking calls through the API gateway",
        "Transfers hit transactions-service, which screens fraud over gRPC and posts ledger updates on accounts :9092",
        "Completions write Confluent Avro outbox rows (SKIP LOCKED relay, poison quarantine) that Redpanda delivers to notification-service"
      ]
    },
    {
      "dot": "emerald",
      "title": "Also in the stack",
      "items": [
        "user-service (.NET) issues identity JWTs behind the gateway",
        "KYC :8091 and cards :8092 are frontend gRPC edges; cards also dials accounts ledger and fraud",
        "disputes, statement, KYC, and AI Temporal workers share the Compose Temporal server; payments stay on overlays"
      ]
    },
    {
      "dot": "rose",
      "title": "Observability",
      "items": [
        "Compose and Kubernetes both export OTLP through otel-collector before Jaeger",
        "Host port 8081 is contended by user-service and Schema Registry; prefer in-network redpanda:8081"
      ]
    }
  ]
