{
  "type": "record",
  "name": "MovementLifecycleEvent",
  "namespace": "com.banking.events",
  "doc": "Customer movement lifecycle on topic movement-lifecycle-v1 (replaces Protobuf JSON wire format)",
  "fields": [
    {"name": "schemaVersion", "type": "int"},
    {"name": "eventId", "type": "string"},
    {"name": "movementId", "type": "string"},
    {"name": "type", "type": "string", "doc": "DEPOSIT, WITHDRAWAL, or TRANSFER"},
    {"name": "fromAccountId", "type": ["null", "long"], "default": null},
    {"name": "toAccountId", "type": ["null", "long"], "default": null},
    {
      "name": "money",
      "type": {
        "type": "record",
        "name": "MovementMoney",
        "fields": [
          {"name": "currency", "type": "string"},
          {"name": "amount", "type": "string"}
        ]
      }
    },
    {"name": "status", "type": "string", "doc": "PENDING, POSTED, or REJECTED"},
    {"name": "occurredAt", "type": "string", "doc": "ISO-8601 instant ending in Z"}
  ]
}
