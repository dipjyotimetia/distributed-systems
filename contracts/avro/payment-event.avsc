{
  "type": "record",
  "name": "PaymentEvent",
  "namespace": "com.banking.events",
  "doc": "Payment lifecycle event on topic payment-events.v1",
  "fields": [
    {"name": "version", "type": "int"},
    {"name": "eventId", "type": "string"},
    {"name": "paymentId", "type": "string"},
    {"name": "customerId", "type": "long"},
    {"name": "amountMinor", "type": "long"},
    {"name": "currency", "type": "string"},
    {"name": "status", "type": "string"},
    {"name": "clearingReference", "type": ["null", "string"], "default": null},
    {"name": "settlementBusinessDate", "type": ["null", "string"], "default": null},
    {"name": "occurredAt", "type": "string", "doc": "ISO-8601 instant"}
  ]
}
