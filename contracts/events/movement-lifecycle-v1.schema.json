{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Movement lifecycle v1",
  "description": "Retries and redeliveries preserve eventId. Publish POSTED only after accounts-service acknowledges its durable posting. Publish REJECTED only after verifying that no posting occurred and any hold was released.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "movementId", "type", "money", "status", "occurredAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "eventId": {"type": "string", "format": "uuid"},
    "movementId": {"type": "string", "format": "uuid"},
    "type": {"enum": ["DEPOSIT", "WITHDRAWAL", "TRANSFER"]},
    "fromAccountId": {"type": "string", "pattern": "^[1-9][0-9]{0,18}$"},
    "toAccountId": {"type": "string", "pattern": "^[1-9][0-9]{0,18}$"},
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "amount"],
      "properties": {
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "amount": {"type": "string", "pattern": "^(0|[1-9][0-9]*)([.][0-9]+)?$", "maxLength": 20}
      }
    },
    "status": {"enum": ["PENDING", "POSTED", "REJECTED"]},
    "occurredAt": {"type": "string", "format": "date-time", "pattern": "Z$"}
  },
  "oneOf": [
    {"properties": {"type": {"const": "DEPOSIT"}, "fromAccountId": false}, "required": ["toAccountId"]},
    {"properties": {"type": {"const": "WITHDRAWAL"}, "toAccountId": false}, "required": ["fromAccountId"]},
    {"properties": {"type": {"const": "TRANSFER"}}, "required": ["fromAccountId", "toAccountId"]}
  ]
}
