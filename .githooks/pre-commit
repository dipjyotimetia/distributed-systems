#!/usr/bin/env bash
# Repo pre-commit hook. Tracked in .githooks/ and enabled with:
#   git config core.hooksPath .githooks      (or: make install-git-hooks)
#
# For each service that has both:
#   tests/replay/services/<service>/requests.json
#   scripts/replay/services/<service>.env
# if the commit touches that service's backend tree, replay suite, or replay
# config, run the offline WireMock replay gate.
#
# Skip for a single commit with:  SKIP_REPLAY=1 git commit ...

set -euo pipefail

if [ "${SKIP_REPLAY:-}" = "1" ] || [ "${SKIP_PROXYMOCK_REPLAY:-}" = "1" ]; then
  echo "pre-commit: SKIP_REPLAY=1 set, skipping offline replay."
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
SUITE_ROOT="${REPO_ROOT}/tests/replay/services"
CONFIG_ROOT="${REPO_ROOT}/scripts/replay/services"
[ -d "$SUITE_ROOT" ] || exit 0

CHANGED="$(git diff --cached --name-only)"
rc=0

for suite in "$SUITE_ROOT"/*/requests.json; do
  [ -e "$suite" ] || continue
  service="$(basename "$(dirname "$suite")")"
  if [ ! -f "${CONFIG_ROOT}/${service}.env" ]; then
    continue
  fi
  if ! printf '%s\n' "$CHANGED" | grep -qE \
    "^(backend/${service}/|tests/replay/services/${service}/|scripts/replay/services/${service}\\.env$)"; then
    continue
  fi

  echo "pre-commit: ${service} changed; running offline WireMock replay..."
  if ! env -u REPLAY_SKIP_BUILD "${REPO_ROOT}/scripts/replay/replay-service.sh" "$service"; then
    echo ""
    echo "pre-commit: ${service} replay FAILED. Fix the service or update"
    echo "tests/replay/services/${service}/, or bypass once with:"
    echo "  SKIP_REPLAY=1 git commit ..."
    rc=1
  else
    echo "pre-commit: ${service} replay passed."
  fi
done

exit "$rc"
